# ════════════════════════════════════════════════════════════════
# BRICKX PROTOCOL — ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env (backend) and fill every value before deploying.
# NEVER commit the filled .env file to git.
# ════════════════════════════════════════════════════════════════

# ── Core ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Public URL of the deployed frontend (used for CORS + email links)
FRONTEND_URL=https://brickxprotocol.io
# Public URL of the platform app (register/login/KYC/buy). Used in email CTAs.
APP_URL=https://app.brickxprotocol.io
# Optional: extra allowed browser origins, comma-separated.
# brickxprotocol.io + all its subdomains are always allowed automatically.
# Useful for temporary Vercel preview URLs during setup, e.g.:
# EXTRA_CORS_ORIGINS=https://brickx-protocol-xxxx.vercel.app
EXTRA_CORS_ORIGINS=

# Optional: rate limits (requests per IP per 15-minute window). Defaults are
# generous enough for normal SPA usage (multi-tab + polling + retries); raise only
# if legitimate users still hit "Too many requests". RATE_LIMIT_MAX = all /api/*
# routes; AUTH_RATE_LIMIT_MAX = /api/auth/* (failed logins only — successful don't count).
RATE_LIMIT_MAX=2000
AUTH_RATE_LIMIT_MAX=30

# ── Supabase (Database) ──────────────────────────────────────────
# Project Settings → API. SERVICE key is secret — backend only,
# never expose it to any frontend.
# Optional: abort a DB query after this many ms so a slow/paused database can't
# hang requests (the public /api/ico/info falls back to defaults). Default 6000.
DB_QUERY_TIMEOUT_MS=6000
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Auth ─────────────────────────────────────────────────────────
# Long random string (e.g. `openssl rand -hex 32`). Server exits at
# boot if missing.
JWT_SECRET=

# ── Compliance ───────────────────────────────────────────────────
# Jurisdictions blocked from registering (comma-separated, case-insensitive).
# Defaults to sanctioned regions; add 'united states' if not registered for US.
RESTRICTED_COUNTRIES=north korea,iran,syria,cuba,crimea

# ── Email (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@brickxprotocol.io
ADMIN_EMAIL=admin@brickxprotocol.io

# ── KYC (Sumsub) ─────────────────────────────────────────────────
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
# Webhook signing secret (Sumsub dashboard → Webhooks). REQUIRED in
# production — webhook calls are rejected without a valid signature.
SUMSUB_WEBHOOK_SECRET=
# Verification level name as configured in the Sumsub dashboard.
# Must match exactly; defaults to basic-kyc-level if unset.
SUMSUB_LEVEL_NAME=basic-kyc-level

# ── Blockchain ───────────────────────────────────────────────────
POLYGON_RPC_URL=https://polygon-rpc.com
BSC_RPC_URL=https://bsc-dataseed.binance.org
# Hours before an unpaid pending order auto-expires (frees reserved cap). Default 72.
ORDER_EXPIRY_HOURS=72
# Treasury wallets that RECEIVE investor payments. Use multisig
# (Gnosis Safe), never a personal EOA.
TREASURY_USDT_POLYGON=
TREASURY_USDC_POLYGON=
TREASURY_ETH=
TREASURY_BNB=
# BEP-20 USDT on BNB Smart Chain. Can be the SAME Safe address as TREASURY_BNB
# above — one Safe deployed on BNB Smart Chain can hold both native BNB and any
# BEP-20 token, including USDT.
TREASURY_USDT_BSC=
# Contract addresses — fill after deployment (testnet first!)
BRX_TOKEN_ADDRESS=
BRICK_TOKEN_ADDRESS=
ICO_VAULT_ADDRESS=
YIELD_DISTRIBUTOR_ADDRESS=

# ── Telegram (bot not yet in package) ────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@BRICKXProtocol
ADMIN_TELEGRAM_IDS=
BRICKX_API_URL=https://api.brickxprotocol.io
