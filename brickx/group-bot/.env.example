# BRICKX group-management bot — copy to .env and fill in. NEVER commit .env.

# Bot token from @BotFather (a SEPARATE bot from the community/announcement bot).
TELEGRAM_GROUP_BOT_TOKEN=

# Optional: restrict the bot to one group id (e.g. -1001234567890). Empty = any
# group it's added to. Get the id by adding the bot and reading startup logs, or
# via @userinfobot in the group.
GROUP_CHAT_ID=

# ── Captcha (anti-bot) ──
CAPTCHA_ENABLED=true
CAPTCHA_TIMEOUT_SEC=120

# ── Anti-scam ──
ANTISPAM_ENABLED=true
BLOCK_LINKS=true          # delete links/URLs from non-admins
BLOCK_FORWARDS=false      # also delete forwarded messages from non-admins
SCAM_STRIKES_BEFORE_MUTE=2
# Comma-separated; leave unset to use the built-in crypto-scam defaults.
SCAM_KEYWORDS=

# ── Copy (optional overrides; {name} is replaced with the member's name) ──
WELCOME_MESSAGE=
RULES_TEXT=
