# BRICKX Telegram bot — copy to .env and fill in. NEVER commit .env.

# Bot token from @BotFather (required — the bot exits without it).
TELEGRAM_BOT_TOKEN=

# Channel the bot auto-posts daily/weekly updates to. The bot account MUST be
# an admin of this channel for posting to work.
TELEGRAM_CHANNEL_ID=@BRICKXProtocol

# Comma-separated numeric Telegram user IDs allowed to run admin commands
# (get your id from @userinfobot). Example: 123456789,987654321
ADMIN_TELEGRAM_IDS=

# Backend API the bot reads live ICO stats from.
BRICKX_API_URL=https://api.brickxprotocol.io

# Optional: make the RAID PRIZE leaderboard permanent (survives restarts) and store
# raiders' submitted X post links. Use the SAME Supabase project as the backend.
# Without these, raid tracking is in-memory only and resets on restart.
# Run backend/migration-006-raid-prize.sql once to create the table.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
