# BRICKX contracts — deploy config. Copy to .env and fill in. NEVER commit .env.

# Deployer wallet private key (testnet wallet for Amoy; for mainnet use a
# hardware/Safe-managed key). No 0x prefix needed but it's accepted.
PRIVATE_KEY=

# RPC endpoints (defaults work, but a dedicated RPC like Alchemy/Infura is more reliable)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_RPC_URL=https://polygon-rpc.com

# Treasury that receives USDC/USDT payments + mint proceeds.
# Leave empty on testnet to default to the deployer. On mainnet use a Gnosis Safe.
TREASURY_ADDRESS=

# Real stablecoin addresses. Leave EMPTY on Amoy/local to auto-deploy mock tokens.
# On Polygon mainnet set the real ones:
#   USDC (native): 0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
#   USDT:          0xc2132D05D31c914a87C6611C10748AEb04B58e8F
USDC_ADDRESS=
USDT_ADDRESS=

# For contract verification on Polygonscan (optional)
POLYGONSCAN_API_KEY=
