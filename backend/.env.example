# ─── APP ───────────────────────────────────────────────────
APP_PORT=3000
APP_ENV=development
APP_SECRET=change_this_to_a_random_secret_min_32_chars

# ─── POSTGRESQL ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=alava
DB_PASSWORD=alava_password
DB_DATABASE=alava_hotel_os
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ─── REDIS ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ───────────────────────────────────────────────────
JWT_SECRET=change_this_jwt_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── S3 / FILE STORAGE ─────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=alava-hotel-os
S3_REGION=ap-southeast-1
