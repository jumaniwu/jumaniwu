# ── Trading Mode ──────────────────────────────────────────────────────────────
# Set to PAPER (default) or LIVE.
# PAPER: public, read-only endpoints only — no credentials required.
# LIVE:  enables real order placement — ALL credentials below must be set.
TRADING_MODE=PAPER

# ── Bybit (required only when TRADING_MODE=LIVE) ──────────────────────────────
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Set to "true" to point at Bybit testnet instead of mainnet
BYBIT_TESTNET=false

# ── Polymarket (required only when TRADING_MODE=LIVE) ─────────────────────────
# EVM private key for the wallet that holds USDC on Polygon
# Format: 64-char hex, optionally 0x-prefixed
POLYMARKET_PRIVATE_KEY=

# Optional: Polymarket CLOB L2 API creds (generated via the CLOB API derive-key endpoint).
# If omitted the system falls back to slower L1 (on-chain) auth.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Polygon chain ID: 137 = mainnet, 80001 = Mumbai testnet
POLYMARKET_CHAIN_ID=137

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
