# ─────────────────────────────────────────────────────────────────────────────
# AI Affiliate Automation Agent — Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM APIs (Free Tier) ──────────────────────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (Llama 3 — fast inference): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── TikTok Content Posting API ────────────────────────────────────────────────
# Apply at: https://developers.tiktok.com/products/content-posting-api/
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
# Access token obtained after completing OAuth2 flow (see README.md)
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_REFRESH_TOKEN=your_tiktok_refresh_token
# Your TikTok account's open_id (returned during OAuth2)
TIKTOK_OPEN_ID=your_tiktok_open_id

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Create bot at: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Your personal or group chat ID (use @userinfobot to find it)
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Apify (Shopee Scraper) ────────────────────────────────────────────────────
# Sign up at: https://apify.com — free tier gives $5 credit/month
APIFY_TOKEN=your_apify_token_here

# ── Magic Hour (Video Generation) ─────────────────────────────────────────────
# Sign up at: https://magichour.ai
MAGIC_HOUR_API_KEY=your_magic_hour_api_key_here

# ── PostgreSQL Database ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=affiliate_db
DB_USER=affiliate_user
DB_PASSWORD=changeme_secure_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── n8n Orchestrator ──────────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_USER=admin
N8N_PASSWORD=changeme_n8n_password
# Generate a 32-character random string: openssl rand -hex 16
N8N_ENCRYPTION_KEY=changeme_32char_encryption_key_here

# ── Agent API Server ──────────────────────────────────────────────────────────
AGENT_HOST=0.0.0.0
AGENT_PORT=8000

# ── Content Settings ─────────────────────────────────────────────────────────
# Minimum product rating to include (0.0 - 5.0)
MIN_PRODUCT_RATING=4.7
# Minimum monthly sales count
MIN_MONTHLY_SOLD=100
# Target niche keywords (comma-separated)
TARGET_KEYWORDS=lampu LED pintar,smart plug,robot vacuum,air purifier,kitchen gadget,smart home,home living

# ── Posting Schedule ─────────────────────────────────────────────────────────
# Cron expression for n8n (default: 8AM and 8PM WIB)
POST_SCHEDULE=0 8,20 * * *
# Base delay between posts in seconds (will be randomized ±40%)
POST_BASE_DELAY_SECONDS=300
